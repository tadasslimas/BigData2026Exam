# =====================================================================
# MacOS specifinis environment.env failas
# =====================================================================

##### !!!!!!!!!!!!
##### SVARBU: MacOS privalomai nurodykite loKalų IP adresą
##### Dėl bridge režimo naudojimo negalima nustatyti lokalaus IP adreso automatiškai 
SPARK_DRIVER_PHYSICAL_IP=192.168.0.95


# --- RESURSAI (Numatytieji / Lokaliai mašinai) ---
SPARK_LOCAL_CORES=24
SPARK_LOCAL_DRIVER_MEMORY=120g
SPARK_LOCAL_OFFHEAP_SIZE=28g


