# =====================================================================
# 🎛️ VIENINGAS PROJEKTO KONFIGŪRACIJOS PULTAS (.env)
# =====================================================================
CODE_VERSION="v11.0.4"

# --- KLASTERIO IR REŽIMO VALDYMAS ---
# 'true' paskirstytam skaičiavimui per host tinklą, 'false' – lokaliam darbui
USING_DISTRIBUTED_CALCULATION=false
SPARK_MASTER_PUBLIC_IP=192.168.0.115
SPARK_MASTER_URL=spark://192.168.0.115:7077

##### !!!!!!!!!!!!
##### SVARBU: MacOS privalomai nurodykite loKalų IP adresą
##### Dėl bridge režimo naudojimo negalima nustatyti lokalaus IP adreso automatiškai 


# --- GEOGRAFINIAI PARAMETRAI ---
TARGET_CENTER_LAT=55.225000
TARGET_CENTER_LON=14.245000
TARGET_MAX_DISTANCE_NM=50.0

# --- NUOSEKLŪS IR NEPRIKLAUSOMI KELIAI HOST MAŠINOJE ---
# Visi kintamieji dabar rodo į bazinius APLANKUS (katalogus).
# Skriptai kuria konkrečius objektus šių aplankų viduje.
HOST_INPUT_DATA_DIR=/opt/A/NFS_Folder/TaskNr4/AIS_DB.CSV

### Diskai MacOS testavimui ant MacbookAir
# HOST_INTERIM_DATA_DIR=../AIS_Task4_Analysis/Interim_Files
# HOST_REPORTS_DATA_DIR=./TaskNr4-Analysis_and_Report
####
#### Diskai MacOS konteinerių testavimui ir lokalus diskai
# HOST_INTERIM_DATA_DIR=./AIS_Task4_Analysis/Interim_Files
# HOST_REPORTS_DATA_DIR=./AIS_Task4_Analysis/Reports
#### Diskai w520 testavimui
# HOST_INTERIM_DATA_DIR=./AIS_Task4_Analysis/Interim_Files
# HOST_REPORTS_DATA_DIR=./AIS_Task4_Analysis/Reports
# HOST_MASTER_PARQUET_DIR=/opt/A/NFS_Folder/TaskNr4/AIS_DB.Parquet


#### QNAP NAS via 1Gbps network
HOST_MASTER_PARQUET_DIR=/Volumes/VolumeA/Tado_Mokslai/TaskNr4/AIS_DB.Parquet
HOST_INPUT_DATA_DIR=/Volumes/VolumeA/Tado_Mokslai/TaskNr4/AIS_DB.CSV
HOST_INTERIM_DATA_DIR=../Output_Data/Interim_Files
HOST_REPORTS_DATA_DIR=./Analysis_and_Reports

#### Išorinis diskas MacOS konteinerio testavimui
# HOST_MASTER_PARQUET_DIR=/Volumes/1000GB/Tado_Mokslai/TaskNr4/AIS_DB.Parquet

# --- ATASKAITŲ IR SKRIPTŲ PARAMETRAI ---
REPORT_TOP_N_EVENTS=5
REPORT_MASTER_TITLE="AIS Incidentų Suvestinė"
REPORT_HTML_FILENAME=AIS_Encounter_Master_Report.html

# --- DOCKER KONTEINERIO VIDINIAI KELIAI ---
# Šie keliai yra fiksuoti konteinerio viduje ir nekeičiami
CONTAINER_INPUT_PATH=/app/data/Input_Data
CONTAINER_INTERIM_PATH=/app/data/Interim_Files
CONTAINER_REPORTS_PATH=/app/data/Reports/detected_encounters.2021-12.csv

